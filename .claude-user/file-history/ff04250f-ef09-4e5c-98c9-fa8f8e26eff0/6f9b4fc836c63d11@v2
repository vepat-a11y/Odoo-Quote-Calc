@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Roboto:wght@400;500;700;900&display=swap');

@tailwind base;
@tailwind components;
@tailwind utilities;

:root {
  --font-display: 'Inter', sans-serif;
  --font-body: 'Inter', sans-serif;

  /* Odoo Light Theme Palette */
  --background: 0 0% 98%;
  --foreground: 340 32% 18%;

  --card: 0 0% 100%;
  --card-foreground: 340 32% 18%;

  --popover: 0 0% 100%;
  --popover-foreground: 340 32% 18%;

  /* Odoo Primary - #714B67 */
  --primary: 318 20% 37%;
  --primary-foreground: 0 0% 100%;

  /* Odoo Secondary - #017E84 */
  --secondary: 182 99% 26%;
  --secondary-foreground: 0 0% 100%;

  --muted: 0 0% 96%;
  --muted-foreground: 0 0% 45%;

  --accent: 182 99% 26%;
  --accent-foreground: 0 0% 100%;

  --destructive: 0 84% 60%;
  --destructive-foreground: 0 0% 100%;

  --border: 0 0% 90%;
  --input: 0 0% 90%;
  --ring: 318 20% 37%;

  /* Odoo brand colors */
  --odoo-primary: #714B67;
  --odoo-secondary: #017E84;
  --odoo-gray: #8F8F8F;
  --odoo-bg: #F5F4F0;
  --odoo-border: #E8E3DC;
}

@layer base {
  body {
    @apply bg-background text-foreground antialiased;
    font-family: var(--font-body);
    background-color: var(--odoo-bg);
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: var(--font-display);
    @apply font-semibold tracking-tight;
  }
}

@layer utilities {
  .glass-panel {
    @apply bg-white border border-gray-200 shadow-sm;
  }

  .glass-card {
    @apply bg-white border border-gray-100 shadow-sm rounded-2xl transition-all duration-200 hover:shadow-md hover:border-gray-200;
  }

  .text-gradient {
    @apply bg-clip-text text-transparent bg-gradient-to-r from-[#714B67] to-[#017E84];
  }

  .input-premium {
    @apply bg-gray-50 border-gray-200 focus:border-[#714B67] focus:ring-[#714B67]/20 transition-all duration-200;
  }

  .odoo-primary-bg {
    background-color: var(--odoo-primary);
  }

  .odoo-secondary-bg {
    background-color: var(--odoo-secondary);
  }

  .odoo-card {
    @apply bg-white rounded-2xl;
    border: 1px solid var(--odoo-border);
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
  }
}

/* Custom scrollbar — sidebar & main panel */
::-webkit-scrollbar {
  width: 5px;
  height: 5px;
}
::-webkit-scrollbar-track {
  background: transparent;
}
::-webkit-scrollbar-thumb {
  background: #D6D3CE;
  border-radius: 99px;
}
::-webkit-scrollbar-thumb:hover {
  background: #A09C96;
}

/* Focus ring overrides */
input:focus-visible,
select:focus-visible,
button:focus-visible {
  outline: 2px solid #714B67;
  outline-offset: 2px;
}

/* Smooth number input arrows removal */
input[type='number']::-webkit-inner-spin-button,
input[type='number']::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}
input[type='number'] {
  -moz-appearance: textfield;
}

/* Print styles */
@media print {
  body {
    background: white !important;
  }
}
