                          {/* ── You Save ── */}
                          {hasAnySavings && (
                            <tr style={{ background: '#F0FDF4' }}>
                              <td className="pl-6 pr-4 py-4 text-sm font-semibold" style={{ color: '#16A34A', borderBottom: '1px solid #DCFCE7' }}>
                                <div className="flex items-center gap-2.5">
                                  <TrendingUp className="w-4 h-4" />
                                  You Save
                                </div>
                              </td>
                              {allQuoteData.map(({ term, data }) => (
                                <td key={term} className="text-right px-5 py-4" style={{ borderBottom: '1px solid #DCFCE7', borderLeft: '1px solid #DCFCE7', fontVariantNumeric: 'tabular-nums' }}>
                                  {data.totalSavings > 0 ? (
                                    <span className="text-sm font-bold" style={{ color: '#16A34A' }}>
                                      {formatCurrency(data.totalSavings)}
                                    </span>
                                  ) : (
                                    <span style={{ color: '#BBF7D0' }}>—</span>
                                  )}
                                </td>
                              ))}
                            </tr>
                          )}

                          {/* Monthly Amortized */}
                          <tr style={{ background: 'white' }}>
                            <td className="pl-6 pr-4 py-4 text-sm font-medium" style={{ color: '#57534E', borderBottom: '1px solid #F0EDE7' }}>
                              Monthly Amortized
                            </td>
                            {allQuoteData.map(({ term, data }) => (
                              <td key={term} className="text-right px-5 py-4" style={{ ...cellBorder, borderBottom: '1px solid #F0EDE7', fontVariantNumeric: 'tabular-nums' }}>
                                <span className="text-sm font-bold" style={{ color: '#714B67' }}>
                                  {formatCurrency(data.amortizedMonthly)}
                                </span>
                                <span className="text-xs font-normal ml-0.5" style={{ color: '#A09C96' }}>/mo</span>
                              </td>
                            ))}
                          </tr>

                          {/* ── Catalyst Finance ── */}
                          {hasAnyFinancing && (
                            <>
                              <tr style={{ background: '#1E3A5F' }}>
                                <td colSpan={colCount + 1} className="px-6 py-3">
                                  <div className="flex items-center gap-3">
                                    <div className="w-6 h-6 rounded-md flex items-center justify-center" style={{ background: 'rgba(255,255,255,0.12)' }}>
                                      <span className="text-white font-black text-[8px]">CF</span>
                                    </div>
                                    <span className="text-xs font-bold text-white/90 uppercase tracking-[0.15em]">Catalyst Finance</span>
                                    <span className="text-xs font-medium ml-auto" style={{ color: 'rgba(147,197,253,0.7)' }}>
                                      {CATALYST_APR_LOW * 100}–{CATALYST_APR_HIGH * 100}% APR
                                    </span>
                                  </div>
                                </td>
                              </tr>
                              <tr style={{ background: '#EFF6FF' }}>
                                <td className="pl-6 pr-4 py-4 text-sm font-medium" style={{ color: '#1E40AF', borderBottom: '1px solid #DBEAFE' }}>
                                  Best Rate
                                  <span className="text-xs font-normal ml-1.5" style={{ color: '#93C5FD' }}>({CATALYST_APR_LOW * 100}%)</span>
                                </td>
                                {allQuoteData.map(({ term, data }) => (
                                  <td key={term} className="text-right px-5 py-4 text-sm font-semibold" style={{ color: '#1E40AF', borderBottom: '1px solid #DBEAFE', borderLeft: '1px solid #DBEAFE', fontVariantNumeric: 'tabular-nums' }}>
                                    {data.financingLow > 0 ? (
                                      <>
                                        {formatCurrency(data.financingLow)}
                                        <span className="text-xs font-normal ml-0.5" style={{ color: '#93C5FD' }}>/mo</span>
                                      </>
                                    ) : <span style={{ color: '#BFDBFE' }}>—</span>}
                                  </td>
                                ))}
                              </tr>
                              <tr style={{ background: '#EFF6FF' }}>
                                <td className="pl-6 pr-4 py-4 text-sm font-medium" style={{ color: '#1E40AF' }}>
                                  Standard Rate
                                  <span className="text-xs font-normal ml-1.5" style={{ color: '#93C5FD' }}>({CATALYST_APR_HIGH * 100}%)</span>
                                </td>
                                {allQuoteData.map(({ term, data }) => (
                                  <td key={term} className="text-right px-5 py-4 text-sm font-semibold" style={{ color: '#1E40AF', borderLeft: '1px solid #DBEAFE', fontVariantNumeric: 'tabular-nums' }}>
                                    {data.financingHigh > 0 ? (
                                      <>
                                        {formatCurrency(data.financingHigh)}
                                        <span className="text-xs font-normal ml-0.5" style={{ color: '#93C5FD' }}>/mo</span>
                                      </>
                                    ) : <span style={{ color: '#BFDBFE' }}>—</span>}
                                  </td>
                                ))}
                              </tr>
                            </>
                          )}

                          {/* ── Partner Payouts ── */}
                          {showPayoutView && (
                            <>
                              <tr style={{ background: '#78350F' }}>
                                <td colSpan={colCount + 1} className="px-6 py-3">
                                  <div className="flex items-center gap-3">
                                    <DollarSign className="w-4 h-4 text-amber-300" />
                                    <span className="text-xs font-bold text-amber-100 uppercase tracking-[0.15em]">Partner Payouts</span>
                                    <span className="text-[9px] bg-white/15 text-amber-200 px-2 py-0.5 rounded-full font-semibold uppercase tracking-wider ml-auto">
                                      Internal
                                    </span>
                                  </div>
                                </td>
                              </tr>
                              <tr style={{ background: '#FFFBEB' }}>
                                <td className="pl-6 pr-4 py-4 text-sm font-medium" style={{ color: '#78350F', borderBottom: '1px solid #FDE68A' }}>
                                  MRR
                                </td>
                                {allQuoteData.map(({ term, data }) => {
                                  const isMonthly = term === 'monthly';
                                  const recurringBase = data.totalSoftwareCost + data.shTotalCost;
                                  const mrr = isMonthly ? recurringBase * 0.8 : recurringBase / 12;
                                  return (
                                    <td key={term} className="text-right px-5 py-4 text-sm font-semibold" style={{ color: '#78350F', borderBottom: '1px solid #FDE68A', borderLeft: '1px solid #FDE68A', fontVariantNumeric: 'tabular-nums' }}>
                                      {formatCurrency(mrr)}
                                    </td>
                                  );
                                })}
                              </tr>
                              {hasAnyImpl && (
                                <tr style={{ background: '#FFFBEB' }}>
                                  <td className="pl-6 pr-4 py-4 text-sm font-medium" style={{ color: '#78350F' }}>
                                    NRR
                                  </td>
                                  {allQuoteData.map(({ term, data }) => (
                                    <td key={term} className="text-right px-5 py-4 text-sm font-semibold" style={{ color: '#78350F', borderLeft: '1px solid #FDE68A', fontVariantNumeric: 'tabular-nums' }}>
                                      {data.implementationCost > 0 ? formatCurrency(data.implementationCost) : <span style={{ color: '#FDE68A' }}>—</span>}
                                    </td>
                                  ))}
                                </tr>
                              )}
                            </>
                          )}

                        </tbody>
                      </table>
                    </div>
                  );
                })()}
              </motion.div>
            ) : (
              /* Empty state */
              <div
                className="flex flex-col items-center justify-center rounded-2xl"
                style={{
                  height: 'calc(100vh - 180px)',
                  border: '2px dashed #E8E3DC',
                  background: 'white',
                }}
              >
                <div
                  className="w-16 h-16 rounded-2xl flex items-center justify-center mb-5"
                  style={{ background: '#F5F4F0' }}
                >
                  <ChevronDown className="w-7 h-7" style={{ color: '#C9C5BE' }} />
                </div>
                <p className="text-base font-semibold mb-1.5" style={{ color: '#78716C' }}>
                  No terms selected
                </p>
                <p className="text-sm" style={{ color: '#A09C96' }}>
                  Choose one or more terms in the sidebar to build your quote
                </p>
              </div>
            )}
          </div>
        </main>
      </div>
    </div>
  );
}
